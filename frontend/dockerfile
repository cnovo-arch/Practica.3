FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY frontend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY frontend/frontend.py ./frontend.py
COPY backend/cliente.py ./cliente.py

EXPOSE 8501

# Ejecuta el cliente de demostración una vez y, a continuación, inicia Streamlit.
# La API se alcanza por el nombre del servicio definido en docker-compose.yml.
CMD ["sh", "-c", "python cliente.py http://backend:8000 && exec streamlit run frontend.py --server.address=0.0.0.0 --server.port=8501"]
